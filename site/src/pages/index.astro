<script>
  import {
    Chart,
    BarElement,
    BarController,
    CategoryScale,
    LinearScale,
    Filler,
    Legend,
    Title,
    Tooltip,
  } from "chart.js";

  Chart.register(
    BarElement,
    BarController,
    CategoryScale,
    Filler,
    Legend,
    LinearScale,
    Title,
    Tooltip
  );

  const benchmarkData = {
    angular: {
      version: "20.0.1",
      run1k: 38.0,
      "size-compressed": 46.3,
    },
    inferno: {
      version: "8.2.2",
      run1k: 23.8,
      "size-compressed": 8.9,
    },
    lit: {
      version: "3.2.1",
      run1k: 27.0,
      "size-compressed": 6.6,
    },
    react: {
      version: "19.2.0",
      run1k: 26.6,
      "size-compressed": 51.4,
    },
    riot: {
      version: "9.4.4",
      run1k: 29.0,
      "size-compressed": 6.4,
    },
    solid: {
      version: "1.9.3",
      run1k: 23.2,
      "size-compressed": 4.5,
    },
    svelte: {
      version: "5.13.0",
      run1k: 23.6,
      "size-compressed": 8.3,
    },
    vue: {
      version: "3.6.0-alpha.2",
      run1k: 26.5,
      "size-compressed": 22.9,
    },
    wallace: {
      version: "0.3.0",
      run1k: 22.2,
      "size-compressed": 1.9,
    },
  };

  const sortData = (data) => {
    const newData = { label: data.label, labels: [], values: [] };
    const arrayOfObj = data.labels.map((d, i) => ({
      label: d,
      value: data.values[i],
    }));
    arrayOfObj.sort((a, b) => a.value - b.value);
    arrayOfObj.forEach((d) => {
      newData.labels.push(d.label);
      newData.values.push(d.value);
    });
    return newData;
  };

  const extractChartData = (data) => {
    const charts = {};
    for (const [framework, stats] of Object.entries(data)) {
      for (const [test, value] of Object.entries(stats)) {
        if (test !== "version") {
          if (!charts.hasOwnProperty(test)) {
            charts[test] = { labels: [], values: [], label: test };
          }
          charts[test].labels.push(framework);
          charts[test].values.push(value);
        }
      }
    }
    return Object.values(charts);
  };

  const buildChart = (ctx, data) => {
    new Chart(ctx, {
      type: "bar",
      data: {
        labels: data.labels,
        datasets: [
          {
            label: data.label,
            data: data.values,
            borderWidth: 1,
            maxBarThickness: 60,
            backgroundColor: "#4169E1",
          },
        ],
      },
      options: {
        plugins: {
          legend: {
            display: false,
          },
        },
        scales: {
          y: {
            beginAtZero: true,
            display: false,
          },
        },
      },
    });
  };

  window.onload = (event) => {
    document
      .getElementById("next")
      .appendChild(document.getElementById("tour-btn").cloneNode(true));

    extractChartData(benchmarkData).forEach((data) => {
      buildChart(document.getElementById(data.label), sortData(data));
    });
  };
</script>
