---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Code } from "@astrojs/starlight/components";
import Landing from "../components/landing.astro";

const repo = "https://github.com/wallace-js/wallace";
const tagline = "Faster loading, rendering and development.";
const stackblitzOptions =
  "?ctl=1&devtoolsheight=1&terminalHeight=0&hideExplorer=1&&embed=1&file=src%2Findex.jsx";
const stackblitzLink =
  "https://stackblitz.com/edit/wallace-example" + stackblitzOptions;
const hero = {
  title: "Wallace",
  tagline: `
  <div class="tagline">
    <span>The front-end framework for:</span>
    <ul>
      <li>Faster loading</li>
      <li>Faster rendering</li>
      <li>Faster development</li>
    </ul>
  </div>
  `,
  image: {
    html: '<img id="logo" src="/img/wallace-tags.png" alt="Wallace logo" />',
  },
  imageAlt: "Wallace logo",
  actions: [
    {
      text: "Tour",
      link: "docs/guide",
      icon: "rocket",
      attrs: {
        id: "tour-btn",
        class: "primary action",
      },
    },
    {
      text: "Docs",
      link: "docs/",
      icon: "open-book",
      attrs: {
        class: "secondary action",
      },
    },
  ],
};
---

<StarlightPage
  frontmatter={{
    title: "Wallace",
    template: "splash",
    hero: hero,
  }}
>
  <Landing>
    <section>
      <h2>Faster loading</h2>
      <p>
        Wallace produces substantially smaller bundles than <a
          href="/docs/claims">almost any other framework</a
        >, making it ideal for landing pages, or serving apps to areas with poor
        connectivity.
      </p>
      <p class="caption">
        Bundle size of various implementations of the
        <a href="https://github.com/krausest/js-framework-benchmark">
          js-framework-benchmark</a
        > app:
      </p>
      <canvas id="size-compressed"></canvas>
    </section>

    <section>
      <h2>Faster rendering</h2>
      <p>
        Wallace renders DOM faster than <a href="/docs/claims"
          >almost any other framework</a
        > and offers more control over updates, making it ideal for performance-critical
        apps.
      </p>
      <p class="caption">
        Time to create 1000 rows on the
        <a href="https://github.com/krausest/js-framework-benchmark">
          js-framework-benchmark</a
        > app:
      </p>
      <canvas id="run1k"></canvas>
    </section>

    <section>
      <h2>Faster development</h2>
      <p>Wallace helps you develop faster by being:</p>
      <h4>Familiar</h4>
      Use JSX and feel right at home:

      <Code
        lang="tsx"
        code={`
const Counter = ({ clicks }) => (
  <div>
    <span>Count: {clicks}</span>
    <button onClick={clicks++}>Click me</button>
  </div>
);
`}
      />

      <h4>Expressive</h4>
      Use special syntax to keep your JSX neat:

      <Code
        lang="tsx"
        code={`
const CounterList = (counters) => (
  <div>
    <Counter.repeat items={counters} />
  </div>
);
`}
      />

      <h4>Helpful</h4>
      Enjoy full TypeScript support and full docs in tool tips:

      <img src="/img/cheat-sheet.jpg" />

      <h4>Explicit</h4>

      Control exactly when and how components update. No magic. No confusion.

      <Code
        lang="tsx"
        code={`
import { mount, watch } from 'wallace';

const counters = [{ clicks: 0 }, { clicks: 0 }];
const root = mount(
  document.getElementById('main'),
  CounterList,
  watch(counters, () => root.update())
);
`}
      />

      <h4>Powerful</h4>

      Update parts inside components:

      <Code
        lang="tsx"
        code={`
const CounterList = (counters) => (
  <div>
    <div part:stats>
      Total: {counters.reduce((a, c) => a + c.clicks, 0)}
    </div>
    <div part:counters>
      <Counter.repeat items={counters} />
    </div>
  </div>
);

const updateStats = () => root.part.stats.update();
`}
      />
      <p>Extend components and override parts:</p>
      <Code
        lang="tsx"
        code={`
import { extendComponent } from 'wallace';

const CounterList = (counters) => (
  <div>
    <stub:stats />
    <div>
      <Counter.repeat items={counters} />
    </div>
  </div>
);

const HighestCounterList = extendComponent(CounterList);

HighestCounterList.stubs.stats = ({ counters }) => (
  <div>
    Highest: {Math.max(...counters.map(c => c.clicks))}
  </div>
);

`}
      />
      <p>Override runtime behaviour:</p>
      <Code
        lang="tsx"
        code={`

const CounterList = (counters) => (
  <div>
    <stub:stats>
    <div>
      <Counter.repeat items={counters} />
    </div>
    <canvas ref:chart />
  </div>
);

CounterList.methods = {
  render(counters) {
    // Handle awkward DOM operation...
    buildChart(this.ref.chart, counters);
    // And let Wallace do the rest...
    this.base.render.call(this, counters);
  }
}
`}
      />
      <p>Create custom directives:</p>
      <Code
        lang="tsx"
        code={`
const CounterList = (counters) => (
  <div>
    <div total:clicks={counters}>
    </div>
    <div>
      <Counter.repeat items={counters} />
    </div>
  </div>
);
`}
      />
      <p>
        Directives operate during compilation, so adding to them doesn't
        increase bundle size.
      </p>
      <div id="next"></div>
    </section>
  </Landing>
</StarlightPage>

<script>
  import {
    Chart,
    BarElement,
    BarController,
    CategoryScale,
    LinearScale,
    Filler,
    Legend,
    Title,
    Tooltip,
  } from "chart.js";

  Chart.register(
    BarElement,
    BarController,
    CategoryScale,
    Filler,
    Legend,
    LinearScale,
    Title,
    Tooltip
  );

  const benchmarkData = {
    angular: {
      version: "20.0.1",
      run1k: 85.6,
      "size-compressed": 46.3,
    },
    inferno: {
      version: "8.2.2",
      run1k: 57.7,
      "size-compressed": 8.9,
    },
    lit: {
      version: "3.2.1",
      run1k: 70.5,
      "size-compressed": 6.6,
    },
    react: {
      version: "19.2.0",
      run1k: 76.5,
      "size-compressed": 51.4,
    },
    riot: {
      version: "9.4.4",
      run1k: 75.4,
      "size-compressed": 6.4,
    },
    solid: {
      version: "1.9.3",
      run1k: 63.9,
      "size-compressed": 4.5,
    },
    svelte: {
      version: "5.13.0",
      run1k: 67.1,
      "size-compressed": 8.3,
    },
    vue: {
      version: "3.6.0-alpha.2",
      run1k: 69.1,
      "size-compressed": 22.9,
    },
    wallace: {
      version: "0.3.0",
      run1k: 55.3,
      "size-compressed": 2.1,
    },
  };

  const sortData = (data) => {
    const newData = { label: data.label, labels: [], values: [] };
    const arrayOfObj = data.labels.map((d, i) => ({
      label: d,
      value: data.values[i],
    }));
    arrayOfObj.sort((a, b) => a.value - b.value);
    arrayOfObj.forEach((d) => {
      newData.labels.push(d.label);
      newData.values.push(d.value);
    });
    return newData;
  };

  const extractChartData = (data) => {
    const charts = {};
    for (const [framework, stats] of Object.entries(data)) {
      for (const [test, value] of Object.entries(stats)) {
        if (test !== "version") {
          if (!charts.hasOwnProperty(test)) {
            charts[test] = { labels: [], values: [], label: test };
          }
          charts[test].labels.push(framework);
          charts[test].values.push(value);
        }
      }
    }
    return Object.values(charts);
  };

  const buildChart = (ctx, data) => {
    new Chart(ctx, {
      type: "bar",
      data: {
        labels: data.labels,
        datasets: [
          {
            label: data.label,
            data: data.values,
            borderWidth: 1,
            maxBarThickness: 60,
            backgroundColor: "#4169E1",
          },
        ],
      },
      options: {
        plugins: {
          legend: {
            display: false,
          },
        },
        scales: {
          y: {
            beginAtZero: true,
            display: false,
          },
        },
      },
    });
  };

  window.onload = (event) => {
    document
      .getElementById("next")
      .appendChild(document.getElementById("tour-btn").cloneNode(true));

    extractChartData(benchmarkData).forEach((data) => {
      buildChart(document.getElementById(data.label), sortData(data));
    });
  };
</script>
