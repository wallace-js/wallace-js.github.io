---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Code } from "@astrojs/starlight/components";
import Landing from "../components/landing.astro";

const repo = "https://github.com/wallace-js/wallace";
const tagline = "Faster loading, rendering and development.";
const stackblitzOptions =
  "?ctl=1&devtoolsheight=1&terminalHeight=0&hideExplorer=1&&embed=1&file=src%2Findex.jsx";
const stackblitzLink =
  "https://stackblitz.com/edit/wallace-example" + stackblitzOptions;
const hero = {
  title: "Wallace",
  tagline: `
  <div class="tagline">
    <span>The front-end framework for:</span>
    <ul>
      <li>Faster loading</li>
      <li>Faster rendering</li>
      <li>Faster development</li>
    </ul>
  </div>
  `,
  image: {
    html: '<img id="logo" src="/img/wallace-tags.png" alt="Wallace logo" />',
  },
  imageAlt: "Wallace logo",
  actions: [
    {
      text: "Tour",
      link: "docs/tour",
      icon: "rocket",
      attrs: {
        id: "tour-btn",
        class: "primary action",
      },
    },
    {
      text: "Docs",
      link: "docs/",
      icon: "open-book",
      attrs: {
        class: "secondary action",
      },
    },
  ],
};
---

<StarlightPage
  frontmatter={{
    title: "Wallace",
    template: "splash",
    hero: hero,
  }}
>
  <Landing>
    <section>
      <h2>Faster loading</h2>
      <p>
        Wallace loads faster than <a href="/docs/claims"
          >almost any other framework</a
        > thanks to its microscopic bundles, making it ideal for landing pages.
      </p>
      <p class="caption">
        Bundle size of various implementations of the
        <a href="https://github.com/krausest/js-framework-benchmark">
          js-framework-benchmark</a
        > app:
      </p>
      <canvas id="size-compressed"></canvas>
    </section>

    <section>
      <h2>Faster rendering</h2>
      <p>
        Wallace renders faster than <a href="/docs/claims"
          >most other frameworks</a
        > and lets you fine tune updates, making it ideal for performance-critical
        apps.
      </p>
      <p class="caption">
        Time to create 1000 rows on the
        <a href="https://github.com/krausest/js-framework-benchmark">
          js-framework-benchmark</a
        > app:
      </p>
      <canvas id="run1k"></canvas>
    </section>

    <section>
      <h2>Faster development</h2>

      <p>Wallace feels like a modern reactive framework:</p>
      <Code
        lang="tsx"
        code={`
import { mount } from 'wallace'; 

const Counter = ({ count }) => (
  <button onClick={count++}>{count}</button>
);

const CounterList = (counters) => (
  <div watch>
    Total: {counters.reduce((a, c) => a + c.count, 0)}
    <button onClick={counters.push({ count: 1 })}> 
      Add Counter
    </button>
    <Counter.repeat models={counters} />
  </div>
);

mount('main', CounterList, []);`}
      />
      <p>
        Try it below or play with the code in StackBlitz (<a
          href="https://stackblitz.com/edit/wallace-js?file=src%2Findex.jsx"
          >JS</a
        > or <a
          href="https://stackblitz.com/edit/wallace-js?file=src%2Findex.tsx"
          >TS</a
        >).
      </p>
      <div id="app">
        <div id="counters"></div>
      </div>
      <p>But frameworks slow down development by:</p>
      <ol>
        <li>
          <strong>Forcing</strong> awkard patterns, which complicates development.
        </li>
        <li>
          <strong>Restricting</strong> your freedom, which requires work-arounds.
        </li>
        <li>
          <strong>Obscuring</strong> internal operations, which impedes debugging.
        </li>
      </ol>
      <p>To see how Wallace solves these issues, and more, take the tour.</p>
      <div id="next"></div>
    </section>
  </Landing>
</StarlightPage>

<script>
  import {
    Chart,
    BarElement,
    BarController,
    CategoryScale,
    LinearScale,
    Filler,
    Legend,
    Title,
    Tooltip,
  } from "chart.js";

  Chart.register(
    BarElement,
    BarController,
    CategoryScale,
    Filler,
    Legend,
    LinearScale,
    Title,
    Tooltip
  );

  const benchmarkData = {
    angular: {
      version: "20.0.1",
      run1k: 38.0,
      "size-compressed": 46.3,
    },
    inferno: {
      version: "8.2.2",
      run1k: 23.8,
      "size-compressed": 8.9,
    },
    lit: {
      version: "3.2.1",
      run1k: 27.0,
      "size-compressed": 6.6,
    },
    react: {
      version: "19.2.0",
      run1k: 26.6,
      "size-compressed": 51.4,
    },
    riot: {
      version: "9.4.4",
      run1k: 29.0,
      "size-compressed": 6.4,
    },
    solid: {
      version: "1.9.3",
      run1k: 23.2,
      "size-compressed": 4.5,
    },
    svelte: {
      version: "5.13.0",
      run1k: 23.6,
      "size-compressed": 8.3,
    },
    vue: {
      version: "3.6.0-alpha.2",
      run1k: 26.5,
      "size-compressed": 22.9,
    },
    wallace: {
      version: "0.3.0",
      run1k: 22.2,
      "size-compressed": 1.9,
    },
  };

  const sortData = (data) => {
    const newData = { label: data.label, labels: [], values: [] };
    const arrayOfObj = data.labels.map((d, i) => ({
      label: d,
      value: data.values[i],
    }));
    arrayOfObj.sort((a, b) => a.value - b.value);
    arrayOfObj.forEach((d) => {
      newData.labels.push(d.label);
      newData.values.push(d.value);
    });
    return newData;
  };

  const extractChartData = (data) => {
    const charts = {};
    for (const [framework, stats] of Object.entries(data)) {
      for (const [test, value] of Object.entries(stats)) {
        if (test !== "version") {
          if (!charts.hasOwnProperty(test)) {
            charts[test] = { labels: [], values: [], label: test };
          }
          charts[test].labels.push(framework);
          charts[test].values.push(value);
        }
      }
    }
    return Object.values(charts);
  };

  const buildChart = (ctx, data) => {
    new Chart(ctx, {
      type: "bar",
      data: {
        labels: data.labels,
        datasets: [
          {
            label: data.label,
            data: data.values,
            borderWidth: 1,
            maxBarThickness: 60,
            backgroundColor: "#4169E1",
          },
        ],
      },
      options: {
        plugins: {
          legend: {
            display: false,
          },
        },
        scales: {
          y: {
            beginAtZero: true,
            display: false,
          },
        },
      },
    });
  };

  window.onload = (event) => {
    document
      .getElementById("next")
      .appendChild(document.getElementById("tour-btn").cloneNode(true));

    extractChartData(benchmarkData).forEach((data) => {
      buildChart(document.getElementById(data.label), sortData(data));
    });
  };
</script>

<script is:inline src="/apps/counter/index.js"></script>
