---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Icon } from "@astrojs/starlight/components";
import Landing from "../components/landing.astro";

const repo = "https://github.com/wallace-js/wallace";
const tagline = "Faster loading, rendering and development.";
const stackblitzOptions =
  "?ctl=1&devtoolsheight=1&terminalHeight=0&hideExplorer=1&&embed=1&file=src%2Findex.jsx";
const stackblitzLink =
  "https://stackblitz.com/edit/wallace-example" + stackblitzOptions;
const hero = {
  title: "Wallace",
  tagline: `
  <div class="tagline">
    <span>The front-end framework for:</span>
    <ul>
      <li>Faster loading</li>
      <li>Faster rendering</li>
      <li>Faster development</li>
    </ul>
  </div>
  `,
  image: {
    // file: '/img/wallace-tags.png',
    html: '<img id="logo" src="/img/wallace-tags.png" alt="Wallace logo" />',
  },
  imageAlt: "Wallace logo",
  actions: [
    {
      text: "Tour",
      link: "docs/guide",
      icon: "rocket",
      attrs: {
        class: "primary action",
      },
    },
    {
      text: "Docs",
      link: "docs/",
      icon: "open-book",
      attrs: {
        class: "secondary action",
      },
    },
  ],
};
---

<StarlightPage
  frontmatter={{
    title: "Wallace",
    template: "splash",
    hero: hero,
  }}
>
  <Landing>
    <section>
      <h2>Faster loading</h2>
      <p>
        Wallace produces substantially smaller bundles than
        <a href="/comparison">any other</a> framework, meaning pages will load faster.
      </p>
      <p class="caption">
        Bundle size of various implementations of the
        <a href="https://github.com/krausest/js-framework-benchmark">
          js-framework-benchmark</a
        > app:
      </p>
      <canvas id="size-compressed"></canvas>
    </section>

    <section>
      <h2>Faster rendering</h2>
      <!--
        <p>
          Wallace comes close to first on 
          <a href="https://github.com/krausest/js-framework-benchmark">official 
          benchmarks</a>, but it has
          more powerful (and nicer) performance tweaking, so it may well be
          "the" fastest.
        </p>
      -->
      <p>
        Wallace renders DOM updates faster than almost
        <a href="/comparison">any other</a> framework, and has better performance
        tweaking capabilities.
      </p>
      <p class="caption">
        Time to create 1000 rows on the
        <a href="https://github.com/krausest/js-framework-benchmark">
          js-framework-benchmark</a
        > app:
      </p>
      <canvas id="run1k"></canvas>
    </section>

    <section>
      <h2>Faster development</h2>
      <p>
        Wallace helps you develop faster by being more:
        <h4>Explicit</h4>
        See exactly when and how components update. No magic. No confusion.

        <h4>Helpful</h4>
        Deep TypeScript support. Docs in tool tips. Easy debugging.

        <h4>Powerful</h4>

        Inherit, extend or partially update any component. Modify run time
        behaviour. Create custom directives.

        <!-- <ul>
          <li>Exposing full docs in the tool tips.</li>
          <li>Override all runtime operations.</li>
          <li>Customise component behaviour.</li>
          <li>Extend syntax by adding your own directives.</li>
        </ul> -->
      </p>

      <div class="follow">
        <a href="/docs/guide">Tour<Icon name="rocket" /> </a>
      </div>

      <!--
      
        being more direct, helpful,
        explicit, flexible, customisable and extendable than other frameworks.
      
      <section>
        <h2>How intuitive?</h2>
        <p>
          Wallace feels like React with the ugly bits removed:
          <ul>
            <li>No mangled JSX.</li>
            <li>No awkward patterns like hooks.</li>
            <li>Just clean and obvious code.</li>
          </ul>
        </p>
        <p>
          You can probably read the <a href="/docs/guide">guide</a> once then use the 
          tooltips as they include a full cheat sheet:
          <img src="/img/cheat-sheet.jpg" alt="Screenshot of cheat sheet" />
        </p>
        <p>
          Here's and embeded <a href="https://stackblitz.com/">StackBlitz</a> 
          (which sadly doesn't render markdown tooltips that well) where you can
          give Wallace a spin:
        </p>
        <iframe src={stackblitzLink}></iframe>
      </section>

      <section>
        <h2>How extendable?</h2>
        <p>
          Wallace lets you:
          <ul>
            <li>Override all runtime operations.</li>
            <li>Customise component behaviour.</li>
            <li>Extend syntax by adding your own directives.</li>
          </ul>
          <br/>
          No other framework gives you this freedom, which is why it is
          called Wallace - although that makes more sense if you've seen
          <a href="https://www.imdb.com/title/tt0112573/">this film</a>:
        </p>
        <img src="/img/braveheart-1.jpg" alt="Braveheart 1995 movie" />
      </section>

    
    -->
    </section>
  </Landing>
</StarlightPage>

<script>
  import {
    Chart,
    BarElement,
    BarController,
    CategoryScale,
    LinearScale,
    Filler,
    Legend,
    Title,
    Tooltip,
  } from "chart.js";

  Chart.register(
    BarElement,
    BarController,
    CategoryScale,
    Filler,
    Legend,
    LinearScale,
    Title,
    Tooltip
  );

  const benchmarkData = {
    angular: {
      version: "20.0.1",
      run1k: 85.6,
      "size-compressed": 46.3,
    },
    inferno: {
      version: "8.2.2",
      run1k: 57.7,
      "size-compressed": 8.9,
    },
    lit: {
      version: "3.2.1",
      run1k: 70.5,
      "size-compressed": 6.6,
    },
    react: {
      version: "19.2.0",
      run1k: 76.5,
      "size-compressed": 51.4,
    },
    riot: {
      version: "9.4.4",
      run1k: 75.4,
      "size-compressed": 6.4,
    },
    solid: {
      version: "1.9.3",
      run1k: 63.9,
      "size-compressed": 4.5,
    },
    svelte: {
      version: "5.13.0",
      run1k: 67.1,
      "size-compressed": 8.3,
    },
    vue: {
      version: "3.6.0-alpha.2",
      run1k: 69.1,
      "size-compressed": 22.9,
    },
    wallace: {
      version: "0.3.0",
      run1k: 55.3,
      "size-compressed": 2.1,
    },
  };

  const sortData = (data) => {
    const newData = { label: data.label, labels: [], values: [] };
    const arrayOfObj = data.labels.map((d, i) => ({
      label: d,
      value: data.values[i],
    }));
    arrayOfObj.sort((a, b) => a.value - b.value);
    arrayOfObj.forEach((d) => {
      newData.labels.push(d.label);
      newData.values.push(d.value);
    });
    return newData;
  };

  const extractChartData = (data) => {
    const charts = {};
    for (const [framework, stats] of Object.entries(data)) {
      for (const [test, value] of Object.entries(stats)) {
        if (test !== "version") {
          if (!charts.hasOwnProperty(test)) {
            charts[test] = { labels: [], values: [], label: test };
          }
          charts[test].labels.push(framework);
          charts[test].values.push(value);
        }
      }
    }
    return Object.values(charts);
  };

  const buildChart = (ctx, data) => {
    new Chart(ctx, {
      type: "bar",
      data: {
        labels: data.labels,
        datasets: [
          {
            label: data.label,
            data: data.values,
            borderWidth: 1,
            maxBarThickness: 60,
            backgroundColor: "#4169E1",
          },
        ],
      },
      options: {
        plugins: {
          legend: {
            display: false,
          },
        },
        scales: {
          y: {
            beginAtZero: true,
            display: false,
          },
        },
      },
    });
  };

  window.onload = (event) => {
    extractChartData(benchmarkData).forEach((data) => {
      buildChart(document.getElementById(data.label), sortData(data));
    });
  };
</script>
