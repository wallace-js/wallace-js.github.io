---
const repo = 'https://github.com/wallace-js/wallace';
const tagline = 'A tiny, fast and logical framework for the front end.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Wallace.js</title>
    <meta name="description" content="{tagline}" />
  </head>

  <body>
    <main>
      <h1>Wallace</h1>

      <img class="logo" src="/img/wallace-tags.png" />
      <p class="tagline">
        {tagline}
      </p>

      <div class="actions">
        <a href="docs/">Documentation</a>
        <a href={repo} class="secondary">GitHub</a>
      </div>

      <section>
        <h2>Why Wallace?</h2>
        <ul>
          <li>Insanely small and fast</li>
          <li>Fine-grained control</li>
          <li>Sensible design</li>
        </ul>
      </section>

    </main>
  </body>

</html>

<style>
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: #0f172a;
    color: #e5e7eb;
  }

  main {
    max-width: 900px;
    margin: auto;
    padding: 4rem 1.5rem;
  }

  h1 {
    font-size: 3rem;
  }

  .logo {
    margin: 0 auto;
    max-width: 50%;
  }

  .tagline {
    color: #94a3b8;
    font-size: 1.2rem;
  }

  .actions {
    margin: 2rem 0;
    display: flex;
    gap: 1rem;
  }

  a {
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    background: #38bdf8;
    color: #020617;
    font-weight: 600;
    text-decoration: none;
  }

  a.secondary {
    background: transparent;
    color: #38bdf8;
    border: 1px solid #38bdf8;
  }

  section {
    margin-top: 4rem;
  }
</style>
